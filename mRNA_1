prepare_subtype_result <- function(
    result_object,
    subtype_name
) {
  
  result_data <- as.data.frame(
    result_object
  )
  
  required_columns <- c(
    "logFC",
    "adj.P.Val"
  )
  
  if (
    !all(
      required_columns %in%
      colnames(result_data)
    )
  ) {
    
    stop(
      paste0(
        "Required columns are missing from ",
        subtype_name,
        " results."
      )
    )
  }
  
  if (
    "ensembl_gene_id" %in%
    colnames(result_data)
  ) {
    
    result_data$ensembl_gene_id <-
      as.character(
        result_data$ensembl_gene_id
      )
    
  } else if (
    all(
      grepl(
        "^ENSG",
        rownames(result_data)
      )
    )
  ) {
    
    result_data$ensembl_gene_id <-
      rownames(
        result_data
      )
    
  } else {
    
    stop(
      paste0(
        "Ensembl gene identifiers are missing from ",
        subtype_name,
        " results."
      )
    )
  }
  
  result_data %>%
    dplyr::mutate(
      ensembl_gene_id = sub(
        "\\..*$",
        "",
        ensembl_gene_id
      )
    ) %>%
    dplyr::filter(
      !is.na(ensembl_gene_id),
      ensembl_gene_id != "",
      is.finite(logFC)
    ) %>%
    dplyr::arrange(
      adj.P.Val
    ) %>%
    dplyr::distinct(
      ensembl_gene_id,
      .keep_all = TRUE
    ) %>%
    dplyr::select(
      ensembl_gene_id,
      logFC,
      adj.P.Val
    ) %>%
    dplyr::rename(
      !!paste0(
        "logFC_",
        subtype_name
      ) := logFC,
      
      !!paste0(
        "adj_P_",
        subtype_name
      ) := adj.P.Val
    )
}


