## 6. Define a function to extract genes for selected pathways
############################################################

extract_occc_pathway_genes <- function(
    selected_pathways,
    gene_mapping,
    go_membership,
    kegg_membership
) {
  
  selected_go_terms <- selected_pathways %>%
    dplyr::filter(
      source %in% c(
        "GO:BP",
        "GO:MF",
        "GO:CC"
      )
    )
  
  selected_go_genes <- selected_go_terms %>%
    dplyr::inner_join(
      go_membership,
      by = "term_id",
      relationship = "many-to-many"
    ) %>%
    dplyr::inner_join(
      gene_mapping,
      by = "ENTREZID",
      relationship = "many-to-many"
    ) %>%
    dplyr::select(
      source,
      term_id,
      term_name,
      FDR = p_value,
      reported_gene_count = intersection_size,
      pathway_size = term_size,
      ensembl_gene_id = ENSEMBL,
      gene_symbol = SYMBOL,
      entrez_id = ENTREZID
    ) %>%
    dplyr::distinct()
  
  selected_kegg_terms <- selected_pathways %>%
    dplyr::filter(
      source == "KEGG"
    )
  
  selected_kegg_genes <- selected_kegg_terms %>%
    dplyr::inner_join(
      kegg_membership,
      by = "term_id",
      relationship = "many-to-many"
    ) %>%
    dplyr::inner_join(
      gene_mapping,
      by = "ENTREZID",
      relationship = "many-to-many"
    ) %>%
    dplyr::select(
      source,
      term_id,
      term_name,
      FDR = p_value,
      reported_gene_count = intersection_size,
      pathway_size = term_size,
      ensembl_gene_id = ENSEMBL,
      gene_symbol = SYMBOL,
      entrez_id = ENTREZID
    ) %>%
    dplyr::distinct()
  
  dplyr::bind_rows(
    selected_go_genes,
    selected_kegg_genes
  ) %>%
    dplyr::arrange(
      source,
      FDR,
      term_name,
      gene_symbol
    )
}


