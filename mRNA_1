]

expr_enoc <- as.matrix(expr_enoc)

# Confirm exact sample alignment
stopifnot(
  ncol(expr_enoc) == nrow(meta_enoc),
  identical(
    colnames(expr_enoc),
    rownames(meta_enoc)
  ),
  all(is.finite(expr_enoc))
)

# Confirm that all cancer samples in this subset are EE
stopifnot(
