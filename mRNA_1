# 3. Enrichment plotting function


plot_gprof_dot_enoc <- function(
    df,
    source_name,
    title_text
) {
  
  df %>%
    dplyr::filter(
      source == source_name
    ) %>%
    dplyr::arrange(
      p_value
    ) %>%
    head(30) %>%
    dplyr::mutate(
      term_name = factor(
        term_name,
        levels = rev(term_name)
      ),
      
      FoldEnriched =
        intersection_size / term_size,
      
      EnrichmentFDR =
        -log10(
          pmax(
            p_value,
            .Machine$double.xmin
          )
        )
    ) %>%
    ggplot2::ggplot(
      ggplot2::aes(
        x = FoldEnriched,
        y = term_name
      )
    ) +
    ggplot2::geom_point(
      ggplot2::aes(
        size = intersection_size,
        colour = EnrichmentFDR
      )
    ) +
    ggplot2::scale_colour_gradient(
      low = "blue",
      high = "red"
    ) +
    ggplot2::scale_size_continuous(
      range = c(3, 8)
    ) +
    ggplot2::labs(
      title = title_text,
      x = "Fold Enrichment",
      y = NULL,
      colour = expression(
        -log[10](p ~ value)
      ),
      size = "Gene count"
    ) +
    ggplot2::theme_minimal(
      base_size = 13
    ) +
    ggplot2::theme(
      axis.text.y = ggplot2::element_text(
        size = 10
      ),
      plot.title = ggplot2::element_text(
        hjust = 0.5,
        face = "bold",
        size = 14
      ),
      legend.position = "right"
    )
}

