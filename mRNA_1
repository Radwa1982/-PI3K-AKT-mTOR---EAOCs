## 3. Function to extract genes for selected pathways


extract_enoc_pathway_genes <- function(
    selected_pathways,
    gene_mapping,
    kegg_membership
) {
  
  # Select GO terms
  
  selected_go_terms <- selected_pathways %>%
    dplyr::filter(
      source %in% c(
        "GO:BP",
        "GO:MF",
        "GO:CC"
      )
    )
  
  # Retrieve genes annotated to selected GO terms
  
  if (nrow(selected_go_terms) > 0) {
    
    selected_go_membership <- AnnotationDbi::select(
      org.Hs.eg.db::org.Hs.eg.db,
      keys = unique(selected_go_terms$term_id),
      keytype = "GOALL",
      columns = "ENTREZID"
    ) %>%
      dplyr::filter(
        !is.na(ENTREZID)
      ) %>%
      dplyr::select(
        term_id = GOALL,
        ENTREZID
      ) %>%
      dplyr::distinct()
    
    selected_go_genes <- selected_go_terms %>%
      dplyr::inner_join(
        selected_go_membership,
        by = "term_id",
        relationship = "many-to-many"
      ) %>%
      dplyr::inner_join(
        gene_mapping,
        by = "ENTREZID",
        relationship = "many-to-many"
      ) %>%
      dplyr::select(
        source,
        term_id,
        term_name,
        FDR = p_value,
        reported_gene_count = intersection_size,
        pathway_size = term_size,
        ensembl_gene_id = ENSEMBL,
        gene_symbol = SYMBOL,
        entrez_id = ENTREZID
      ) %>%
      dplyr::distinct()
    
  } else {
    
    selected_go_genes <- data.frame()
  }
  
  # Select KEGG pathways
  
  selected_kegg_terms <- selected_pathways %>%
    dplyr::filter(
      source == "KEGG"
    )
  
  # Retrieve genes belonging to selected KEGG pathways
  
  if (nrow(selected_kegg_terms) > 0) {
    
    selected_kegg_genes <- selected_kegg_terms %>%
      dplyr::inner_join(
        kegg_membership,
        by = "term_id",
        relationship = "many-to-many"
      ) %>%
      dplyr::inner_join(
        gene_mapping,
        by = "ENTREZID",
        relationship = "many-to-many"
      ) %>%
      dplyr::select(
        source,
        term_id,
        term_name,
        FDR = p_value,
        reported_gene_count = intersection_size,
        pathway_size = term_size,
        ensembl_gene_id = ENSEMBL,
        gene_symbol = SYMBOL,
        entrez_id = ENTREZID
      ) %>%
      dplyr::distinct()
    
  } else {
    
    selected_kegg_genes <- data.frame()
  }
  
  # Combine GO and KEGG genes
  
  dplyr::bind_rows(
    selected_go_genes,
    selected_kegg_genes
  ) %>%
    dplyr::arrange(
      source,
      FDR,
      term_name,
      gene_symbol
    )
}



