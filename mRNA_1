    "ENSEMBL"
  )
) %>%
  dplyr::filter(
    !is.na(ENSEMBL)
  ) %>%
  dplyr::distinct(
    SYMBOL,
    ENSEMBL
  ) %>%
  dplyr::rename(
    gene_symbol = SYMBOL,
    ensembl_gene_id = ENSEMBL
  )


############################################################
## 3. Prepare existing differential-expression results
############################################################

prepare_mtor_dotplot_results <- function(
    results_object,
    histotype_name
) {
  
  results_df <- as.data.frame(
    results_object
  )
  
  if (
    !"ensembl_gene_id" %in% names(
      results_df
    )
  ) {
    
    results_df <- results_df %>%
      tibble::rownames_to_column(
        "ensembl_gene_id"
      )
    
  }
  
  required_columns <- c(
    "ensembl_gene_id",
    "logFC",
    "adj.P.Val"
  )
  
  missing_columns <- setdiff(
    required_columns,
    names(
      results_df
    )
  )
  
  if (
    length(
      missing_columns
    ) > 0
  ) {
    
    stop(
      paste(
        "Missing required columns for",
        histotype_name,
        ":",
        paste(
          missing_columns,
          collapse = ", "
        )
      )
    )
    
  }
  
  results_df %>%
    dplyr::mutate(
      ensembl_gene_id = sub(
        "\\..*$",
        "",
        as.character(
          ensembl_gene_id
        )
      ),
      
      logFC = as.numeric(
        logFC
      ),
      
      adjusted_P = as.numeric(
        adj.P.Val
      ),
      
      histotype = histotype_name,
      
      significance = dplyr::case_when(
        is.na(adjusted_P) ~ NA_character_,
        adjusted_P < 0.0001 ~ "****",
        adjusted_P < 0.001 ~ "***",
        adjusted_P < 0.01 ~ "**",
        adjusted_P < 0.05 ~ "*",
        TRUE ~ "ns"
      ),
      
      direction = dplyr::case_when(
        logFC > 0 ~ "Upregulated",
        logFC < 0 ~ "Downregulated",
        TRUE ~ "No change"
      )
    ) %>%
    dplyr::filter(
      !is.na(ensembl_gene_id),
      ensembl_gene_id != "",
      is.finite(logFC),
      !is.na(adjusted_P)
    ) %>%
    dplyr::arrange(
      adjusted_P
    ) %>%
    dplyr::distinct(
      ensembl_gene_id,
      .keep_all = TRUE
    ) %>%
    dplyr::select(
      ensembl_gene_id,
      histotype,
      logFC,
      adjusted_P,
      significance,
      direction
    )
  
}


############################################################
## 4. Prepare results for each histotype
############################################################

