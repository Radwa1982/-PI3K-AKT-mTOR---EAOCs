    meta_enoc$Type[
      meta_enoc$condition == "Cancer"
    ] == "EE"
  )
)

table(meta_enoc$condition)
table(meta_enoc$Type)

# Set condition levels explicitly
meta_enoc$condition <- factor(
  meta_enoc$condition,
  levels = c("Cancer", "Normal")
)

# Remove unused dataset levels
meta_enoc$batch_1 <- droplevels(
  factor(meta_enoc$batch_1)
)

# Construct the design matrix
design_enoc <- model.matrix(
  ~ 0 + condition,
  data = meta_enoc
)

# Cancer now represents EnOC
colnames(design_enoc) <- c(
  "EnOC",
  "Normal"
)

stopifnot(
  identical(
    colnames(design_enoc),
    c("EnOC", "Normal")
  ),
  nrow(design_enoc) == ncol(expr_enoc)
)

# Estimate within-dataset correlation
dup_corr_enoc <- limma::duplicateCorrelation(
  expr_enoc,
  design_enoc,
  block = meta_enoc$batch_1
)

# Fit the linear model
fit_enoc <- limma::lmFit(
  expr_enoc,
  design_enoc,
  block = meta_enoc$batch_1,
  correlation = dup_corr_enoc$consensus
)

# Define the EnOC-versus-normal contrast
contrast_enoc <- limma::makeContrasts(
  EnOC_vs_Normal = EnOC - Normal,
  levels = design_enoc
)

# Apply the contrast and empirical Bayes moderation
fit2_enoc <- limma::contrasts.fit(
  fit_enoc,
  contrast_enoc
)

fit2_enoc <- limma::eBayes(
  fit2_enoc
)

# Extract all results
