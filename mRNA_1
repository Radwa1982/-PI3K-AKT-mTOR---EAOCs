    significance_group = dplyr::case_when(
      
      significant_OCCC &
        significant_EnOC ~
        "Significant in both",
      
      significant_OCCC &
        !significant_EnOC ~
        "OCCC only",
      
      !significant_OCCC &
        significant_EnOC ~
        "EnOC only",
      
      TRUE ~
        "Significant in neither"
    ),
    
    effect_difference =
      logFC_OCCC - logFC_EnOC,
    
    absolute_effect_difference =
      abs(
        effect_difference
      )
  )

