      !is.na(meta_FDR) &
      meta_FDR < 0.05 &
      abs(meta_logFC) > 1
  )


############################################################
## 4. Summarize direction across individual GEO datasets
############################################################

dataset_direction_summary <-
  study_effect_sizes_decoupled %>%
  dplyr::mutate(
    ensembl_gene_id = sub(
      "\\..*$",
      "",
      as.character(
        ensembl_gene_id
      )
    ),
    
    logFC = as.numeric(
      logFC
    )
  ) %>%
  dplyr::filter(
    !is.na(ensembl_gene_id),
    ensembl_gene_id != "",
    is.finite(logFC)
  ) %>%
  dplyr::group_by(
    ensembl_gene_id
  ) %>%
  dplyr::summarise(
    datasets_evaluated = dplyr::n_distinct(
      dataset
    ),
    
    datasets_upregulated = sum(
      logFC > 0
    ),
    
    datasets_downregulated = sum(
      logFC < 0
    ),
    
    consistent_direction_all_datasets =
      datasets_upregulated == datasets_evaluated |
      datasets_downregulated == datasets_evaluated,
    
    minimum_dataset_logFC = min(
      logFC
    ),
    
