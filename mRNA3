    hjust = -0.05,
    
    vjust = 1.2,
    
    size = 3
  ) +
  
  ggplot2::scale_x_continuous(
    limits = c(
      0,
      100
    ),
    
    breaks = seq(
      0,
      100,
      by = 25
    )
  ) +
  
  ggplot2::labs(
    title =
      "Between-dataset heterogeneity",
    
    x =
      expression(
        I^2 ~ "(%)"
      ),
    
    y =
      "Number of supported primary DEGs"
  ) +
  
  ggplot2::theme_bw(
    base_size = 10
  ) +
  
  ggplot2::theme(
    panel.grid.minor =
      ggplot2::element_blank(),
    
    plot.title =
      ggplot2::element_text(
        face = "bold",
        
        size = 10
      )
  )


############################################################
## 9. Summarize heterogeneity categories
############################################################

heterogeneity_category_summary <-
  supported_heterogeneity_data %>%
  dplyr::count(
    heterogeneity_category,
    
    name = "number_of_genes",
    
    .drop = FALSE
  ) %>%
  dplyr::mutate(
    percentage =
      100 * number_of_genes /
      sum(
        number_of_genes
      ),
    
    label = paste0(
      format(
        number_of_genes,
        
        big.mark = ","
      ),
      
      "\n(",
      
      sprintf(
        "%.1f",
        percentage
      ),
      
      "%)"
    )
  )


############################################################
## 10. Create Panel C:
## Heterogeneity categories
############################################################

plot_C <- ggplot2::ggplot(
  heterogeneity_category_summary,
  
  ggplot2::aes(
    x = heterogeneity_category,
    
    y = percentage,
    
    fill = heterogeneity_category
  )
) +
  
  ggplot2::geom_col(
    width = 0.75
  ) +
  
  ggplot2::geom_text(
    ggplot2::aes(
      label = label
    ),
    
    vjust = -0.4,
    
    size = 3
  ) +
  
  ggplot2::scale_fill_manual(
    values = c(
      "Low" = "#56B4E9",
      
      "Moderate" = "#009E73",
      
      "Substantial" = "#E69F00",
      
      "High" = "#D55E00"
    )
  ) +
  
  ggplot2::scale_y_continuous(
    expand = ggplot2::expansion(
      mult = c(
        0,
        0.18
      )
    )
  ) +
  
  ggplot2::labs(
    title =
      "Heterogeneity categories",
    
    x =
      expression(
        I^2 ~ "category"
      ),
    
    y =
      "Supported primary DEGs (%)"
  ) +
  
  ggplot2::theme_bw(
    base_size = 10
  ) +
  
  ggplot2::theme(
    panel.grid.minor =
      ggplot2::element_blank(),
    
    legend.position =
      "none",
    
    plot.title =
      ggplot2::element_text(
        face = "bold",
        
        size = 10
      ),
    
    axis.text.x =
      ggplot2::element_text(
        angle = 25,
        
        hjust = 1
      )
  )


