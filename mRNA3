        meta_FDR < 0.05 &
          same_direction ~ TRUE,
        
        TRUE ~ FALSE
      ),
    
    fully_supported = dplyr::case_when(
      !evaluated_in_meta ~ NA,
      
      is.na(meta_FDR) ~ NA,
      
      meta_FDR < 0.05 &
        abs(meta_logFC) > 1 &
        same_direction ~ TRUE,
      
      TRUE ~ FALSE
    ),
    
