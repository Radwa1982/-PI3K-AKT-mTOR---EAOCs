############################################################
## 3. Calculate the typical within-study variance
## required to estimate I-squared
############################################################

gene_sampling_variance <-
  heterogeneity_study_data %>%
  dplyr::mutate(
    ensembl_gene_id = sub(
      "\\..*$",
      "",
      as.character(
        ensembl_gene_id
      )
    )
  ) %>%
  dplyr::filter(
    !is.na(ensembl_gene_id),
    ensembl_gene_id != "",
    is.finite(study_variance),
    study_variance > 0
  ) %>%
  dplyr::distinct(
    ensembl_gene_id,
    dataset,
    .keep_all = TRUE
  ) %>%
  dplyr::mutate(
    inverse_variance_weight =
      1 / study_variance
  ) %>%
  dplyr::group_by(
    ensembl_gene_id
  ) %>%
  dplyr::summarise(
    studies_for_I2 = dplyr::n(),
    
    sum_weights = sum(
      inverse_variance_weight
    ),
    
    sum_squared_weights = sum(
      inverse_variance_weight^2
    ),
    
    typical_sampling_variance =
      dplyr::if_else(
        studies_for_I2 > 1 &
          sum_weights^2 > sum_squared_weights,
        
        (
          (studies_for_I2 - 1) *
            sum_weights
        ) /
          (
            sum_weights^2 -
              sum_squared_weights
          ),
        
        NA_real_
      ),
    
    .groups = "drop"
  ) %>%
  dplyr::select(
    ensembl_gene_id,
    studies_for_I2,
    typical_sampling_variance
  )


