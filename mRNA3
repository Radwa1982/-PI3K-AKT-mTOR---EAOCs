############################################################
## META-ANALYSIS OF FIVE GEO CANCER DATASETS
## USING SHARED GTEx NORMAL CONTROLS
##
## Starts with filtered count data before ComBat-seq
## and before quantile normalization.
############################################################


############################################################
## 1. Load required packages
############################################################

library(edgeR)
library(limma)
library(metafor)
library(dplyr)
library(openxlsx)


packageVersion("edgeR")
packageVersion("limma")

############################################################
## 2. Prepare count matrix and metadata
############################################################

counts_meta <- as.matrix(counts_all)

metadata_meta <- as.data.frame(meta)

metadata_meta$sample_id <- as.character(
  metadata_meta$sample_id
)

# Standardize sample identifiers so GTEx sample names
# match between the count matrix and metadata.

colnames(counts_meta) <- gsub(
  "\\.",
  "-",
  colnames(counts_meta)
)

metadata_meta$sample_id <- gsub(
  "\\.",
  "-",
  metadata_meta$sample_id
)

stopifnot(
  !anyDuplicated(colnames(counts_meta)),
  !anyDuplicated(metadata_meta$sample_id),
  setequal(
    colnames(counts_meta),
    metadata_meta$sample_id
  )
)

# Reorder metadata to match the count matrix.

metadata_meta <- metadata_meta[
  match(
    colnames(counts_meta),
    metadata_meta$sample_id
  ),
  ,
  drop = FALSE
]

rownames(metadata_meta) <- metadata_meta$sample_id

stopifnot(
  identical(
    colnames(counts_meta),
    rownames(metadata_meta)
  )
)


############################################################
## 3. Exclude GSE160692
############################################################

keep_samples <- metadata_meta$batch_1 != "GSE160692"

counts_meta <- counts_meta[
  ,
  keep_samples,
  drop = FALSE
]

metadata_meta <- metadata_meta[
  keep_samples,
  ,
  drop = FALSE
]

metadata_meta$batch_1 <- droplevels(
  factor(metadata_meta$batch_1)
)

stopifnot(
  identical(
    colnames(counts_meta),
    rownames(metadata_meta)
  ),
  !"GSE160692" %in% as.character(
    metadata_meta$batch_1
  )
)

############################################################
## 4. Retain GEO cancer samples and GTEx normal controls
############################################################

keep_analysis_samples <- (
  metadata_meta$source == "GEO" &
    metadata_meta$condition == "Cancer"
) | (
  metadata_meta$source == "GTEx" &
    metadata_meta$condition == "Normal"
)

counts_meta <- counts_meta[
  ,
  keep_analysis_samples,
  drop = FALSE
]

metadata_meta <- metadata_meta[
  keep_analysis_samples,
  ,
  drop = FALSE
]

metadata_meta$batch_1 <- droplevels(
  factor(
    metadata_meta$batch_1
  )
)

stopifnot(
  identical(
    colnames(counts_meta),
    rownames(metadata_meta)
  )
)



############################################################
## 5. Check the number of datasets and normal samples
############################################################

cancer_datasets <- sort(
  unique(
    as.character(
      metadata_meta$batch_1[
        metadata_meta$source == "GEO" &
          metadata_meta$condition == "Cancer"
      ]
    )
  )
)

normal_index <- which(
  metadata_meta$source == "GTEx" &
    metadata_meta$condition == "Normal"
)

stopifnot(
  length(cancer_datasets) == 5,
  length(normal_index) == 149
)


############################################################
## 6. Confirm that the previously filtered count matrix
## is suitable for analysis
############################################################

stopifnot(
  nrow(counts_meta) > 0,
  all(is.finite(counts_meta)),
  all(counts_meta >= 0)
)

############################################################
## 7. Apply TMM normalization
############################################################

dge_meta <- edgeR::DGEList(
  counts = counts_meta
)

dge_meta <- edgeR::calcNormFactors(
  dge_meta,
  method = "TMM"
)


############################################################
## 8. Define GEO datasets and GTEx sequencing centres
############################################################

metadata_meta$analysis_group <- ifelse(
  metadata_meta$source == "GTEx",
  paste0(
    "GTEx_",
    metadata_meta$batch_1
  ),
  paste0(
    "GEO_",
    metadata_meta$batch_1
  )
)

metadata_meta$analysis_group <- factor(
  metadata_meta$analysis_group
)


unique(metadata_meta$analysis_group)

############################################################
## 9. Create the design matrix
############################################################

design_meta <- model.matrix(
  ~ 0 + analysis_group,
  data = metadata_meta
)

colnames(design_meta) <- levels(
  metadata_meta$analysis_group
)

stopifnot(
  nrow(design_meta) == ncol(counts_meta),
  qr(design_meta)$rank == ncol(design_meta)
)


############################################################
## 10. Apply the voom transformation
############################################################

voom_meta <- limma::voom(
  dge_meta,
  design_meta,
  plot = TRUE
)


############################################################
## 11. Fit the limma model
############################################################

fit_meta <- limma::lmFit(
  voom_meta,
  design_meta
)


head(
  fit_meta$coefficients
)


############################################################
## 12. Identify GEO datasets and GTEx sequencing centres
############################################################

cancer_groups <- grep(
  "^GEO_",
  colnames(design_meta),
  value = TRUE
)

normal_groups <- grep(
  "^GTEx_",
  colnames(design_meta),
  value = TRUE
)

stopifnot(
  length(cancer_groups) == 5,
  length(normal_groups) == 2
)


############################################################
## 13. Create cancer-versus-GTEx contrasts
############################################################

contrast_matrix <- matrix(
  0,
  nrow = ncol(design_meta),
  ncol = length(cancer_groups),
  dimnames = list(
    colnames(design_meta),
    cancer_groups
  )
)

for (
  dataset_name in cancer_groups
) {
  
  contrast_matrix[
    dataset_name,
    dataset_name
  ] <- 1
  
  contrast_matrix[
    normal_groups,
    dataset_name
  ] <- -1 / length(
    normal_groups
  )
  
}

print(
  contrast_matrix
)

############################################################
## 14. Fit contrasts and apply empirical Bayes moderation
############################################################

fit_meta_contrasts <- limma::contrasts.fit(
  fit_meta,
  contrast_matrix
)

fit_meta_contrasts <- limma::eBayes(
  fit_meta_contrasts
)


############################################################
## 15. Extract results for each GEO dataset
############################################################

dataset_results <- lapply(
  cancer_groups,
  function(dataset_name) {
    
    results_dataset <- limma::topTable(
      fit_meta_contrasts,
      coef = dataset_name,
      number = Inf,
      sort.by = "none",
      confint = TRUE
    )
    
    results_dataset$ensembl_gene_id <- rownames(
      results_dataset
    )
    
    results_dataset$dataset <- sub(
      "^GEO_",
      "",
      dataset_name
    )
    
    # Calculate the limma moderated standard error.
    
    moderated_standard_errors <-
      fit_meta_contrasts$stdev.unscaled[
        ,
        dataset_name
      ] *
      sqrt(
        fit_meta_contrasts$s2.post
      )
    
    names(moderated_standard_errors) <- rownames(
      fit_meta_contrasts$coefficients
    )
    
    results_dataset$standard_error <-
      moderated_standard_errors[
        results_dataset$ensembl_gene_id
      ]
    
    results_dataset %>%
      dplyr::select(
        ensembl_gene_id,
        dataset,
        logFC,
        standard_error,
        CI.L,
        CI.R,
        AveExpr,
        t,
        P.Value,
        adj.P.Val,
        B
      )
    
  }
)

names(dataset_results) <- sub(
  "^GEO_",
  "",
  cancer_groups
)

study_effect_sizes <- dplyr::bind_rows(
  dataset_results
)


############################################################
## 16. Calculate group-specific precision from voom weights
############################################################

group_weight_totals <- voom_meta$weights %*%
  design_meta

rownames(group_weight_totals) <- rownames(
  voom_meta$E
)

colnames(group_weight_totals) <- colnames(
  design_meta
)

stopifnot(
  all(is.finite(group_weight_totals)),
  all(group_weight_totals > 0)
)


############################################################
## 17. Extract moderated gene-specific variance
############################################################

posterior_variance <- fit_meta_contrasts$s2.post

names(posterior_variance) <- rownames(
  fit_meta_contrasts$coefficients
)

stopifnot(
  length(posterior_variance) ==
    nrow(group_weight_totals),
  all(is.finite(posterior_variance)),
  all(posterior_variance > 0)
)


############################################################
## 18. Calculate variance attributable to GTEx controls
############################################################

# Each GTEx centre contributes equally to the
# cancer-versus-normal comparisons.

normal_centre_weights <- abs(
  contrast_matrix[
    normal_groups,
    cancer_groups[1]
  ]
)

# Variance of the shared GTEx reference for each gene.

shared_control_variance <- posterior_variance *
  rowSums(
    sweep(
      1 / group_weight_totals[
        ,
        normal_groups,
        drop = FALSE
      ],
      2,
      normal_centre_weights^2,
      "*"
    )
  )

names(shared_control_variance) <- rownames(
  group_weight_totals
)


############################################################
## 19. Calculate dataset-specific cancer variance
############################################################

cancer_specific_variance <- sweep(
  1 / group_weight_totals[
    ,
    cancer_groups,
    drop = FALSE
  ],
  1,
  posterior_variance,
  "*"
)

rownames(cancer_specific_variance) <- rownames(
  group_weight_totals
)

colnames(cancer_specific_variance) <- cancer_groups


############################################################
## 20. Check that calculated variances match limma
############################################################

reconstructed_total_variance <- sweep(
  cancer_specific_variance,
  1,
  shared_control_variance,
  "+"
)

limma_total_variance <- sweep(
  fit_meta_contrasts$stdev.unscaled[
    ,
    cancer_groups,
    drop = FALSE
  ]^2,
  1,
  posterior_variance,
  "*"
)

stopifnot(
  isTRUE(
    all.equal(
      unname(
        reconstructed_total_variance
      ),
      unname(
        limma_total_variance
      ),
      tolerance = 1e-6,
      check.attributes = FALSE
    )
  )
)


############################################################
## 21. Apply the Han et al. decoupling transformation
############################################################

# For a covariance matrix consisting of dataset-specific
# variances plus one shared-control component, the
# following calculation is equivalent to:
#
# 1 / colSums(solve(covariance_matrix))

dataset_precision_sum <- rowSums(
  1 / cancer_specific_variance
)

decoupling_factor <- 1 +
  shared_control_variance *
  dataset_precision_sum

decoupled_variance <- sweep(
  cancer_specific_variance,
  1,
  decoupling_factor,
  "*"
)

decoupled_standard_error <- sqrt(
  decoupled_variance
)

rownames(decoupled_standard_error) <- rownames(
  cancer_specific_variance
)

colnames(decoupled_standard_error) <- cancer_groups


############################################################
## 22. Verify the decoupling transformation for one gene
############################################################

example_gene <- 1

example_covariance <- matrix(
  shared_control_variance[example_gene],
  nrow = length(cancer_groups),
  ncol = length(cancer_groups)
)

diag(
  example_covariance
) <- cancer_specific_variance[
  example_gene,
] + shared_control_variance[example_gene]

example_decoupled_variance <- 1 / colSums(
  solve(
    example_covariance
  )
)

stopifnot(
  isTRUE(
    all.equal(
      as.numeric(
        decoupled_variance[
          example_gene,
        ]
      ),
      as.numeric(
        example_decoupled_variance
      ),
      tolerance = 1e-6
    )
  )
)


############################################################
## 23. Add decoupled standard errors to study-level results
############################################################

decoupled_dataset_results <- lapply(
  cancer_groups,
  function(dataset_name) {
    
    dataset_label <- sub(
      "^GEO_",
      "",
      dataset_name
    )
    
    results_dataset <- dataset_results[[dataset_label]]
    
    gene_positions <- match(
      results_dataset$ensembl_gene_id,
      rownames(
        decoupled_standard_error
      )
    )
    
    results_dataset$shared_control_variance <-
      shared_control_variance[
        gene_positions
      ]
    
    results_dataset$cancer_specific_variance <-
      cancer_specific_variance[
        gene_positions,
        dataset_name
      ]
    
    results_dataset$decoupled_variance <-
      decoupled_variance[
        gene_positions,
        dataset_name
      ]
    
    results_dataset$decoupled_standard_error <-
      decoupled_standard_error[
        gene_positions,
        dataset_name
      ]
    
    results_dataset
    
  }
)

names(decoupled_dataset_results) <- sub(
  "^GEO_",
  "",
  cancer_groups
)

study_effect_sizes_decoupled <- dplyr::bind_rows(
  decoupled_dataset_results
)


############################################################
## 24. Perform random-effects meta-analysis for each gene
############################################################

effect_size_matrix <- fit_meta_contrasts$coefficients[
  ,
  cancer_groups,
  drop = FALSE
]

meta_analysis_list <- lapply(
  seq_len(
    nrow(effect_size_matrix)
  ),
  function(gene_index) {
    
    if (
      gene_index %% 1000 == 0
    ) {
      
      message(
        "Analysed ",
        gene_index,
        " of ",
        nrow(effect_size_matrix),
        " genes."
      )
      
    }
    
    gene_id <- rownames(
      effect_size_matrix
    )[gene_index]
    
    gene_effect_sizes <- as.numeric(
      effect_size_matrix[
        gene_index,
      ]
    )
    
    gene_decoupled_variance <- as.numeric(
      decoupled_variance[
        gene_index,
      ]
    )
    
    valid_datasets <- is.finite(
      gene_effect_sizes
    ) &
      is.finite(
        gene_decoupled_variance
      ) &
      gene_decoupled_variance > 0
    
    if (
      sum(valid_datasets) < 2
    ) {
      
      return(
        data.frame(
          ensembl_gene_id = gene_id,
          number_of_datasets = sum(
            valid_datasets
          ),
          meta_logFC = NA_real_,
          standard_error = NA_real_,
          lower_CI = NA_real_,
          upper_CI = NA_real_,
          P.Value = NA_real_,
          tau_squared = NA_real_,
          stringsAsFactors = FALSE
        )
      )
      
    }
    
    gene_model <- tryCatch(
      metafor::rma.uni(
        yi = gene_effect_sizes[
          valid_datasets
        ],
        vi = gene_decoupled_variance[
          valid_datasets
        ],
        method = "REML"
      ),
      error = function(e) {
        NULL
      }
    )
    
    if (
      is.null(
        gene_model
      )
    ) {
      
      return(
        data.frame(
          ensembl_gene_id = gene_id,
          number_of_datasets = sum(
            valid_datasets
          ),
          meta_logFC = NA_real_,
          standard_error = NA_real_,
          lower_CI = NA_real_,
          upper_CI = NA_real_,
          P.Value = NA_real_,
          tau_squared = NA_real_,
          stringsAsFactors = FALSE
        )
      )
      
    }
    
    data.frame(
      ensembl_gene_id = gene_id,
      number_of_datasets = sum(
        valid_datasets
      ),
      meta_logFC = as.numeric(
        stats::coef(
          gene_model
        )
      ),
      standard_error = as.numeric(
        gene_model$se
      ),
      lower_CI = as.numeric(
        gene_model$ci.lb
      ),
      upper_CI = as.numeric(
        gene_model$ci.ub
      ),
      P.Value = as.numeric(
        gene_model$pval
      ),
      tau_squared = as.numeric(
        gene_model$tau2
      ),
      stringsAsFactors = FALSE
    )
    
  }
)


meta_analysis_results <- dplyr::bind_rows(
  meta_analysis_list
)

sum(
  meta_analysis_results$tau_squared == 0,
  na.rm = TRUE
)

sum(
  is.na(
    meta_analysis_results$meta_logFC
  )
)
meta_analysis_results <- meta_analysis_results %>%
  dplyr::filter(
    !is.na(meta_logFC)
  )
############################################################
## 25. Adjust P values for multiple testing
############################################################

meta_analysis_results <- meta_analysis_results %>%
  dplyr::mutate(
    adj.P.Val = stats::p.adjust(
      P.Value,
      method = "BH"
    ),
    direction = dplyr::case_when(
      meta_logFC > 0 ~ "Upregulated",
      meta_logFC < 0 ~ "Downregulated",
      TRUE ~ NA_character_
    )
  ) %>%
  dplyr::arrange(
    adj.P.Val
  )


############################################################
## 26. Identify significant genes
############################################################

significant_meta_genes <- meta_analysis_results %>%
  dplyr::filter(
    !is.na(
      adj.P.Val
    ),
    adj.P.Val < 0.05,
    abs(
      meta_logFC
    ) > 1
  )

upregulated_meta_genes <- significant_meta_genes %>%
  dplyr::filter(
    meta_logFC > 1
  )

downregulated_meta_genes <- significant_meta_genes %>%
  dplyr::filter(
    meta_logFC < -1
  )


############################################################
## 27. Create a summary table
############################################################

meta_analysis_summary <- data.frame(
  analysis = c(
    "GEO cancer datasets",
    "GTEx normal samples",
    "Genes analysed",
    "Significant genes",
    "Upregulated genes",
    "Downregulated genes"
  ),
  number = c(
    length(cancer_groups),
    length(normal_index),
    nrow(meta_analysis_results),
    nrow(significant_meta_genes),
    nrow(upregulated_meta_genes),
    nrow(downregulated_meta_genes)
  ),
  stringsAsFactors = FALSE
)


