## Primary pooled limma analysis versus
## shared-control random-effects meta-analysis
############################################################


############################################################
## 1. Confirm that the required objects exist
############################################################

stopifnot(
  exists("results_EAOC"),
  exists("meta_analysis_results"),
  exists("study_effect_sizes_decoupled")
)


############################################################
## 2. Prepare the primary pooled limma results
############################################################

primary_limma_results <- as.data.frame(
  results_EAOC
)

# Only use row names when an Ensembl identifier column
# is not already present.

if (
  !"ensembl_gene_id" %in%
  names(primary_limma_results)
) {
  
  primary_limma_results <-
    tibble::rownames_to_column(
      primary_limma_results,
      var = "ensembl_gene_id"
    )
  
}

stopifnot(
  all(
    c(
      "ensembl_gene_id",
      "logFC",
      "adj.P.Val"
    ) %in%
      names(primary_limma_results)
  )
)

primary_limma_results <- primary_limma_results %>%
  dplyr::mutate(
    ensembl_gene_id = sub(
      "\\..*$",
      "",
      as.character(
        ensembl_gene_id
      )
    ),
    
    primary_logFC = as.numeric(
      logFC
    ),
    
    primary_FDR = as.numeric(
      adj.P.Val
    )
  ) %>%
  dplyr::filter(
    !is.na(ensembl_gene_id),
    ensembl_gene_id != "",
    is.finite(primary_logFC)
  ) %>%
  dplyr::arrange(
    primary_FDR
  ) %>%
  dplyr::distinct(
    ensembl_gene_id,
    .keep_all = TRUE
  ) %>%
  dplyr::select(
    ensembl_gene_id,
    
    dplyr::any_of(
      c(
        "external_gene_name",
        "gene_symbol",
        "SYMBOL"
      )
    ),
    
    primary_logFC,
    primary_FDR
