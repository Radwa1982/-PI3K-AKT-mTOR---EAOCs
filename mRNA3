      !is.na(primary_FDR) &
      primary_FDR < 0.05 &
      abs(primary_logFC) > 1
  )


############################################################
## 3. Prepare the meta-analysis results
############################################################

sensitivity_meta_results <- as.data.frame(
  meta_analysis_results
)

stopifnot(
  all(
    c(
      "ensembl_gene_id",
      "meta_logFC"
    ) %in%
      names(sensitivity_meta_results)
  )
)

# Calculate adjusted P values if they have not yet
# been added to the meta-analysis results.

if (
  !"adj.P.Val" %in%
  names(sensitivity_meta_results)
) {
  
  stopifnot(
    "P.Value" %in%
      names(sensitivity_meta_results)
  )
  
  sensitivity_meta_results$adj.P.Val <-
    p.adjust(
      sensitivity_meta_results$P.Value,
      method = "BH"
    )
  
}

sensitivity_meta_results <-
  sensitivity_meta_results %>%
  dplyr::mutate(
    ensembl_gene_id = sub(
      "\\..*$",
      "",
      as.character(
        ensembl_gene_id
      )
    ),
    
    meta_logFC = as.numeric(
      meta_logFC
    ),
    
    meta_FDR = as.numeric(
      adj.P.Val
    )
  ) %>%
  dplyr::filter(
    !is.na(ensembl_gene_id),
