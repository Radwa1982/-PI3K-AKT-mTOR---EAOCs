############################################################
# 3. FIVE-DATASET LODO LOOP
############################################################

LODO5_results <- list()

LODO5_summary <- data.frame(
  excluded_dataset = character(),
  excluded_samples = integer(),
  remaining_cancer = integer(),
  remaining_normal = integer(),
  significant_DEGs = integer(),
  overlap_with_full5 = integer(),
  overlap_percentage = numeric(),
  logFC_spearman_correlation = numeric(),
  direction_concordance = numeric(),
  stringsAsFactors = FALSE
)

for (excluded_dataset in geo_datasets5) {
  
  message(
    "Running five-dataset LODO: excluding ",
    excluded_dataset
  )
  
  keep_lodo5 <- !(
    meta_full5$source == "GEO" &
      meta_full5$batch_1 == excluded_dataset
  )
  
  expr_lodo5 <- expr_full5[
    ,
    keep_lodo5,
    drop = FALSE
  ]
  
  meta_lodo5 <- meta_full5[
    keep_lodo5,
    ,
    drop = FALSE
  ]
  
  meta_lodo5$batch_1 <- droplevels(
    factor(meta_lodo5$batch_1)
  )
  
  stopifnot(
    ncol(expr_lodo5) == nrow(meta_lodo5),
    identical(
      colnames(expr_lodo5),
      meta_lodo5$sample_id
    ),
    all(
      c("Cancer", "Normal") %in%
        unique(meta_lodo5$condition)
    )
  )
  
  # Refit the same limma model used in the primary analysis
  result_lodo5 <- run_limma_same_design(
    expression_matrix = expr_lodo5,
    metadata = meta_lodo5
  )
  
  # Apply the primary-analysis significance criteria
  significant_lodo5 <- result_lodo5$gene_id[
    !is.na(result_lodo5$adj.P.Val) &
      result_lodo5$adj.P.Val < 0.05 &
      abs(result_lodo5$logFC) > 1
  ]
  
  # Match genes between the complete five-dataset analysis
  # and the current LODO analysis
  common_genes5 <- intersect(
    full5_result$gene_id,
    result_lodo5$gene_id
  )
  
  full5_match <- full5_result[
    match(
      common_genes5,
      full5_result$gene_id
    ),
    ,
    drop = FALSE
  ]
  
  lodo5_match <- result_lodo5[
    match(
      common_genes5,
      result_lodo5$gene_id
    ),
    ,
    drop = FALSE
  ]
  
  # Spearman correlation of log2 fold changes
  logFC_correlation5 <- cor(
    full5_match$logFC,
    lodo5_match$logFC,
    method = "spearman",
    use = "complete.obs"
  )
  
  # Concordance in effect direction
  usable_genes5 <- (
    is.finite(full5_match$logFC) &
      is.finite(lodo5_match$logFC) &
      full5_match$logFC != 0 &
      lodo5_match$logFC != 0
  )
  
  direction_concordance5 <- mean(
    sign(full5_match$logFC[usable_genes5]) ==
      sign(lodo5_match$logFC[usable_genes5])
  )
  
  # Overlap of significant genes
  overlap_genes5 <- intersect(
    full5_significant,
    significant_lodo5
  )
  
  overlap_percentage5 <- if (
    length(full5_significant) > 0
  ) {
    100 * length(overlap_genes5) /
      length(full5_significant)
  } else {
    NA_real_
  }
  
  # Add results to the summary
  LODO5_summary <- dplyr::bind_rows(
    LODO5_summary,
    data.frame(
      excluded_dataset = excluded_dataset,
      excluded_samples = sum(!keep_lodo5),
      remaining_cancer = sum(
        meta_lodo5$condition == "Cancer"
      ),
      remaining_normal = sum(
        meta_lodo5$condition == "Normal"
      ),
      significant_DEGs = length(
        significant_lodo5
      ),
      overlap_with_full5 = length(
        overlap_genes5
      ),
      overlap_percentage = overlap_percentage5,
      logFC_spearman_correlation =
        logFC_correlation5,
      direction_concordance =
        direction_concordance5
    )
  )
  
  # Add significance indicator to complete iteration result
  result_lodo5$significant <- (
    !is.na(result_lodo5$adj.P.Val) &
      result_lodo5$adj.P.Val < 0.05 &
      abs(result_lodo5$logFC) > 1
  )
  
  LODO5_results[[excluded_dataset]] <-
    result_lodo5
}


