make_density_data <- function(
    expression_matrix,
    sample_ids,
    metadata
) {
  
  # Ensure sample identifiers are character
  sample_ids <- as.character(sample_ids)
  
  # Select samples and force the result to be a matrix
  density_matrix <- as.matrix(
    expression_matrix[
      ,
      sample_ids,
      drop = FALSE
    ]
  )
  
  # Melt using the matrix method
  density_data <- reshape2::melt(
    density_matrix,
    varnames = c("Gene", "Sample"),
    value.name = "LogExpression"
  )
  
  density_data$Gene <- as.character(
    density_data$Gene
  )
  
  density_data$Sample <- as.character(
    density_data$Sample
  )
  
  # Match sample information
  sample_match <- match(
    density_data$Sample,
    metadata$sample_id
  )
  
  density_data$Batch <- metadata$batch_1[
    sample_match
  ]
  
  density_data$Source <- metadata$source[
    sample_match
  ]
  
  density_data$Condition <- metadata$condition[
    sample_match
  ]
  
  # Stop if any samples failed to match
  if (anyNA(density_data$Batch)) {
    
    unmatched_samples <- unique(
      density_data$Sample[
        is.na(density_data$Batch)
      ]
    )
    
    stop(
      "The following samples did not match the metadata: ",
      paste(unmatched_samples, collapse = ", ")
    )
  }
  
  density_data
}

select_density_samples <- function(
    metadata,
    number_per_batch = 4,
    seed = 123
) {
  metadata <- as.data.frame(metadata)
  
  # Check required columns
  required_columns <- c("sample_id", "batch_1")
  
  missing_columns <- setdiff(
    required_columns,
    colnames(metadata)
  )
  
  if (length(missing_columns) > 0) {
    stop(
      "Missing metadata columns: ",
      paste(missing_columns, collapse = ", ")
    )
  }
  
  # Check sample identifiers
  if (anyNA(metadata$sample_id)) {
    stop("metadata$sample_id contains missing values.")
  }
  
  if (anyDuplicated(metadata$sample_id)) {
    stop("metadata$sample_id contains duplicated values.")
  }
  
  # Remove samples without batch information
  valid_metadata <- metadata[
    !is.na(metadata$batch_1),
    ,
    drop = FALSE
  ]
  
  set.seed(seed)
  
  # Split sample IDs according to batch
  samples_by_batch <- split(
    valid_metadata$sample_id,
    valid_metadata$batch_1
  )
  
  # Select up to the requested number from every batch
  selected_samples <- unlist(
    lapply(
      samples_by_batch,
      function(ids) {
        sample(
          ids,
          size = min(number_per_batch, length(ids)),
          replace = FALSE
        )
      }
    ),
    use.names = FALSE
  )
  
  as.character(selected_samples)
}
