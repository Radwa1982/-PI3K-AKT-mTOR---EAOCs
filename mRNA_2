# Design the Lodo loop
# Limma design 

run_limma_same_design <- function(
    expression_matrix,
    metadata
) {
  expression_matrix <- as.matrix(expression_matrix)
  metadata <- as.data.frame(metadata)
  
  stopifnot(
    ncol(expression_matrix) == nrow(metadata),
    identical(
      colnames(expression_matrix),
      metadata$sample_id
    )
  )
  
  # Match the terminology used in your primary analysis
  metadata$condition <- factor(
    metadata$condition,
    levels = c("Cancer", "Normal"),
    labels = c("EAOCs", "Normal")
  )
  
  metadata$batch_1 <- droplevels(
    factor(metadata$batch_1)
  )
  
  stopifnot(
    !anyNA(metadata$condition),
    all(c("EAOCs", "Normal") %in% metadata$condition)
  )
  
  design <- model.matrix(
    ~ 0 + condition,
    data = metadata
  )
  
  colnames(design) <- c("EAOCs", "Normal")
  
  dup_corr <- duplicateCorrelation(
    expression_matrix,
    design,
    block = metadata$batch_1
  )
  
  fit <- lmFit(
    expression_matrix,
    design,
    block = metadata$batch_1,
    correlation = dup_corr$consensus
  )
  
  contrast_matrix <- makeContrasts(
    EAOCsVsNormal = EAOCs - Normal,
    levels = design
  )
  
  fit2 <- contrasts.fit(
    fit,
    contrast_matrix
  )
  
  fit2 <- eBayes(fit2)
  
  results <- topTable(
    fit2,
    coef = "EAOCsVsNormal",
    adjust.method = "BH",
    number = Inf,
    sort.by = "none"
  )
  
  results$gene_id <- rownames(results)
  
  results
}



