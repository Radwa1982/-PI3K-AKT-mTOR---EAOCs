calculate_rle <- function(expression_matrix) {
  
  expression_matrix <- as.matrix(expression_matrix)
  
  # Replace non-finite values
  expression_matrix[
    !is.finite(expression_matrix)
  ] <- NA_real_
  
  gene_medians <- apply(
    expression_matrix,
    1,
    median,
    na.rm = TRUE
  )
  
  keep_genes <- is.finite(gene_medians)
  
  expression_matrix <- expression_matrix[
    keep_genes,
    ,
    drop = FALSE
  ]
  
  gene_medians <- gene_medians[keep_genes]
  
  sweep(
    expression_matrix,
    1,
    gene_medians,
    FUN = "-"
  )
}


