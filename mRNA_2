############################################################
# LEAVE-ONE-DATASET-OUT LOOP
############################################################

LODO_results <- list()

LODO_summary <- data.frame(
  excluded_dataset = character(),
  excluded_samples = integer(),
  remaining_cancer = integer(),
  remaining_normal = integer(),
  significant_DEGs = integer(),
  overlap_with_full6 = integer(),
  overlap_percentage = numeric(),
  logFC_spearman_correlation = numeric(),
  direction_concordance = numeric(),
  stringsAsFactors = FALSE
)

for (excluded_dataset in geo_datasets) {
  
  message("Running LODO: excluding ", excluded_dataset)
  
  # Remove every sample belonging to one GEO dataset
  keep_samples <- !(
    meta_full6$source == "GEO" &
      meta_full6$batch_1 == excluded_dataset
  )
  
  expr_lodo <- expr_full6[
    ,
    keep_samples,
    drop = FALSE
  ]
  
  meta_lodo <- meta_full6[
    keep_samples,
    ,
    drop = FALSE
  ]
  
  # Confirm sample alignment and presence of both conditions
  stopifnot(
    ncol(expr_lodo) == nrow(meta_lodo),
    identical(
      colnames(expr_lodo),
      meta_lodo$sample_id
    ),
    all(
      c("Cancer", "Normal") %in%
        unique(meta_lodo$condition)
    )
  )
  
  # Run limma using the same design as the primary analysis
  result_lodo <- run_limma_same_design(
    expression_matrix = expr_lodo,
    metadata = meta_lodo
  )
  
  # Apply the same significance thresholds
  significant_lodo <- result_lodo$gene_id[
    !is.na(result_lodo$adj.P.Val) &
      result_lodo$adj.P.Val < 0.05 &
      abs(result_lodo$logFC) > 1
  ]
  
  # Match genes between full and LODO analyses
  common_genes <- intersect(
    full6_result$gene_id,
    result_lodo$gene_id
  )
  
  full_match <- full6_result[
    match(common_genes, full6_result$gene_id),
    ,
    drop = FALSE
  ]
  
  lodo_match <- result_lodo[
    match(common_genes, result_lodo$gene_id),
    ,
    drop = FALSE
  ]
  
  # Compare log-fold changes
  logFC_correlation <- cor(
    full_match$logFC,
    lodo_match$logFC,
    method = "spearman",
    use = "complete.obs"
  )
  
  # Check whether fold-change directions agree
  usable_genes <- (
    is.finite(full_match$logFC) &
      is.finite(lodo_match$logFC) &
      full_match$logFC != 0 &
      lodo_match$logFC != 0
  )
  
  direction_concordance <- mean(
    sign(full_match$logFC[usable_genes]) ==
      sign(lodo_match$logFC[usable_genes])
  )
  
  # Significant-gene overlap
  overlap_genes <- intersect(
    full6_significant,
    significant_lodo
  )
  
  overlap_percentage <- if (
    length(full6_significant) > 0
  ) {
    100 * length(overlap_genes) /
      length(full6_significant)
  } else {
    NA_real_
  }
  
  # Save summary statistics
  LODO_summary <- dplyr::bind_rows(
    LODO_summary,
    data.frame(
      excluded_dataset = excluded_dataset,
      excluded_samples = sum(!keep_samples),
      remaining_cancer = sum(
        meta_lodo$condition == "Cancer"
      ),
      remaining_normal = sum(
        meta_lodo$condition == "Normal"
      ),
      significant_DEGs = length(significant_lodo),
      overlap_with_full6 = length(overlap_genes),
      overlap_percentage = overlap_percentage,
      logFC_spearman_correlation = logFC_correlation,
      direction_concordance = direction_concordance
    )
  )
  
  # Save complete results for this exclusion
  LODO_results[[excluded_dataset]] <- result_lodo
}


