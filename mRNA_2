############################################################

run_pca <- function(expression_matrix, metadata) {
  
  expression_matrix <- as.matrix(expression_matrix)
  metadata <- as.data.frame(metadata)
  
  # Confirm that metadata columns are uniquely named
  if (anyDuplicated(colnames(metadata))) {
    stop(
      "Metadata contains duplicated column names: ",
      paste(
        unique(
          colnames(metadata)[duplicated(colnames(metadata))]
        ),
        collapse = ", "
      )
    )
  }
  
  # Confirm that samples are correctly aligned
  stopifnot(
    ncol(expression_matrix) == nrow(metadata),
    identical(
      colnames(expression_matrix),
      metadata$sample_id
    )
  )
  
  pca <- prcomp(
    t(expression_matrix),
    center = TRUE,
    scale. = FALSE
  )
  
  variance <- pca$sdev^2
  variance_percent <- variance / sum(variance) * 100
  
  # Start with metadata rather than adding it to another
  # data frame that already contains sample_id
  pca_data <- metadata
  
  pca_data$PC1 <- pca$x[, 1]
  pca_data$PC2 <- pca$x[, 2]
  
  list(
    pca = pca,
    data = pca_data,
    variance_percent = variance_percent
  )
}


# Define the plot function 

plot_pca <- function(
    pca_result,
    colour_by,
    shape_by,
    title = NULL
) {
  stopifnot(
    is.list(pca_result),
    all(c("data", "variance_percent") %in% names(pca_result)),
    colour_by %in% colnames(pca_result$data),
    shape_by %in% colnames(pca_result$data)
  )
  
  ggplot(
    pca_result$data,
    aes(
      x = PC1,
      y = PC2,
      colour = .data[[colour_by]],
      shape = .data[[shape_by]]
    )
  ) +
    geom_point(size = 3, alpha = 0.85) +
    labs(
      title = title,
      x = sprintf(
        "PC1 (%.1f%%)",
        pca_result$variance_percent[1]
      ),
      y = sprintf(
        "PC2 (%.1f%%)",
        pca_result$variance_percent[2]
      ),
      colour = colour_by,
      shape = shape_by
    ) +
    theme_classic() +
    theme(
      plot.title = element_text(face = "bold")
    )
}
