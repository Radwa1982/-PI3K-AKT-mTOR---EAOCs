clean_sample_names <- function(x) {
  x <- trimws(x)
  x <- gsub("SRR\\s+", "SRR", x)
  x <- gsub("^Aligned_reads/", "", x)
  x <- gsub("^Aligned_", "", x)
  x <- gsub("\\.bam$", "", x)
  x <- gsub("_fully_cleaned\\.sorted$", "", x)
  x <- gsub("\\.sorted$", "", x)
  x <- gsub("_R1_001$", "", x)
  x <- gsub("_cleaned$", "", x)
  x <- gsub("_fully$", "", x)
  x <- gsub("/", "_", x)
  x <- gsub("\\.", "_", x)
  x
}

