# ============================================================
# LEAVE-ONE-DATASET-OUT ANALYSIS
# ============================================================

miRNA_datasets <- levels(
  droplevels(miRNA_metadata$batch)
)

LOSO_miRNA_results <- list()
LOSO_miRNA_significant <- list()

LOSO_miRNA_summary <- data.frame(
  excluded_dataset = character(),
  remaining_samples = integer(),
  remaining_cancer = integer(),
  remaining_normal = integer(),
  significant_miRNAs = integer(),
  upregulated = integer(),
  downregulated = integer(),
  log2FC_correlation = numeric(),
  directional_concordance = numeric(),
  model_status = character(),
  stringsAsFactors = FALSE
)

for (excluded_dataset in miRNA_datasets) {
  
  message("Excluding: ", excluded_dataset)
  
  # Exclude one dataset
  keep_samples <-
    miRNA_metadata$batch != excluded_dataset
  
  counts_sub <- miRNA_count_matrix_filtered[
    ,
    keep_samples,
    drop = FALSE
  ]
  
  metadata_sub <- miRNA_metadata[
    keep_samples,
    ,
    drop = FALSE
  ]
  
  metadata_sub$batch <- droplevels(
    metadata_sub$batch
  )
  
  metadata_sub$Condition <- droplevels(
    metadata_sub$Condition
  )
  
  stopifnot(
    identical(
      colnames(counts_sub),
      rownames(metadata_sub)
    )
  )
  
  # Both conditions must remain
  if (nlevels(metadata_sub$Condition) < 2) {
    
    warning(
      excluded_dataset,
      ": only one condition remains; model skipped."
    )
    
    LOSO_miRNA_summary <- rbind(
      LOSO_miRNA_summary,
      data.frame(
        excluded_dataset = excluded_dataset,
        remaining_samples = ncol(counts_sub),
        remaining_cancer =
          sum(metadata_sub$Condition == "Cancer"),
        remaining_normal =
          sum(metadata_sub$Condition == "Normal"),
        significant_miRNAs = NA_integer_,
        upregulated = NA_integer_,
        downregulated = NA_integer_,
        log2FC_correlation = NA_real_,
        directional_concordance = NA_real_,
        model_status = "Skipped: one condition",
        stringsAsFactors = FALSE
      )
    )
    
    next
  }
  
  # Check whether batch and condition remain estimable
  design_sub <- model.matrix(
    ~ batch + Condition,
    data = metadata_sub
  )
  
  if (qr(design_sub)$rank < ncol(design_sub)) {
    
    warning(
      excluded_dataset,
      ": batch and condition are confounded; model skipped."
    )
    
    LOSO_miRNA_summary <- rbind(
      LOSO_miRNA_summary,
      data.frame(
        excluded_dataset = excluded_dataset,
        remaining_samples = ncol(counts_sub),
        remaining_cancer =
          sum(metadata_sub$Condition == "Cancer"),
        remaining_normal =
          sum(metadata_sub$Condition == "Normal"),
        significant_miRNAs = NA_integer_,
        upregulated = NA_integer_,
        downregulated = NA_integer_,
        log2FC_correlation = NA_real_,
        directional_concordance = NA_real_,
        model_status = "Skipped: rank-deficient design",
        stringsAsFactors = FALSE
      )
    )
    
    next
  }
  
  # Fit DESeq2 model
  dds_sub <- DESeqDataSetFromMatrix(
    countData = counts_sub,
    colData = metadata_sub,
    design = ~ batch + Condition
  )
  
  dds_sub <- DESeq(
    dds_sub,
    quiet = TRUE
  )
  
  res_sub <- results(
    dds_sub,
    contrast = c(
      "Condition",
      "Cancer",
      "Normal"
    ),
    alpha = 0.05
  )
  
  res_sub <- as.data.frame(res_sub)
  res_sub$miRNA <- rownames(res_sub)
  res_sub$excluded_dataset <- excluded_dataset
  
  sig_sub <- res_sub %>%
    dplyr::filter(
      !is.na(padj),
      padj < 0.05,
      abs(log2FoldChange) > 1
    )
  
  LOSO_miRNA_results[[excluded_dataset]] <- res_sub
  LOSO_miRNA_significant[[excluded_dataset]] <- sig_sub
  
  # Compare LOSO effect sizes with the full analysis
  common_miRNAs <- intersect(
    rownames(res_miRNA_EAOC_df),
    rownames(res_sub)
  )
  
  full_logFC <- res_miRNA_EAOC_df[
    common_miRNAs,
    "log2FoldChange"
  ]
  
  sub_logFC <- res_sub[
    common_miRNAs,
    "log2FoldChange"
  ]
  
  valid <- is.finite(full_logFC) &
    is.finite(sub_logFC)
  
  log2FC_correlation <- cor(
    full_logFC[valid],
    sub_logFC[valid],
    method = "spearman"
  )
  
  directional_concordance <- mean(
    sign(full_logFC[valid]) ==
      sign(sub_logFC[valid])
  )
  
  LOSO_miRNA_summary <- rbind(
    LOSO_miRNA_summary,
    data.frame(
      excluded_dataset = excluded_dataset,
      remaining_samples = ncol(counts_sub),
      remaining_cancer =
        sum(metadata_sub$Condition == "Cancer"),
      remaining_normal =
        sum(metadata_sub$Condition == "Normal"),
      significant_miRNAs = nrow(sig_sub),
      upregulated =
        sum(sig_sub$log2FoldChange > 1),
      downregulated =
        sum(sig_sub$log2FoldChange < -1),
      log2FC_correlation = log2FC_correlation,
      directional_concordance =
        directional_concordance,
      model_status = "Completed",
      stringsAsFactors = FALSE
    )
  )
}

