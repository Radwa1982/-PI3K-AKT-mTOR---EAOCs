############################################################
## Publication-ready PCA of batch-adjusted miRNA expression
############################################################


############################################################
## 1. Load required packages
############################################################

library(DESeq2)
library(limma)
library(ggplot2)
library(ggpubr)


############################################################
## 2. Generate variance-stabilised expression values
############################################################

vsd <- DESeq2::varianceStabilizingTransformation(
  dds_miRNA,
  blind = FALSE
)


############################################################
## 3. Preserve disease status during batch adjustment
############################################################

condition_design <- model.matrix(
  ~ Condition,
  data = as.data.frame(
    SummarizedExperiment::colData(vsd)
  )
)

batch_corrected_expression <- limma::removeBatchEffect(
  x = SummarizedExperiment::assay(vsd),
  
  batch = SummarizedExperiment::colData(
    vsd
  )$batch,
  
  design = condition_design
)


############################################################
## 4. Select the 500 most variable miRNAs
############################################################

miRNA_variance <- matrixStats::rowVars(
  batch_corrected_expression
)

number_variable_miRNAs <- min(
  500,
  nrow(batch_corrected_expression)
)

selected_miRNAs <- order(
  miRNA_variance,
  decreasing = TRUE
)[
  seq_len(
    number_variable_miRNAs
  )
]


############################################################
## 5. Perform PCA
############################################################

pca_result <- stats::prcomp(
  t(
    batch_corrected_expression[
      selected_miRNAs,
      ,
      drop = FALSE
    ]
  ),
  
  center = TRUE,
  
  scale. = FALSE
)

variance_explained <- 100 *
  pca_result$sdev^2 /
  sum(
    pca_result$sdev^2
  )


############################################################
## 6. Prepare plotting data
############################################################

pca_metadata <- as.data.frame(
  SummarizedExperiment::colData(vsd)
)

pca_data <- data.frame(
  sample_id = rownames(pca_metadata),
  
  PC1 = pca_result$x[, 1],
  
  PC2 = pca_result$x[, 2],
  
  Condition = as.character(
    pca_metadata$Condition
  ),
  
  Type = as.character(
    pca_metadata$Type
  ),
  
  Dataset = as.character(
    pca_metadata$batch
  ),
  
  stringsAsFactors = FALSE
)

pca_data$Histotype <- dplyr::case_when(
